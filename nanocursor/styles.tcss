Screen { }

#title-bar {
    dock: top;
    width: 100%;
    height: 2;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* --- Provider Selection --- */

#provider-select {
    align: center middle;
    width: 100%;
    height: 1fr;
}

#select-label {
    text-align: center;
    width: 100%;
    height: auto;
    margin-top: 2;
    text-style: bold;
}

#provider-list {
    width: 90%;
    max-width: 60;
    height: auto;
    max-height: 16;
    margin: 1 2;
}

/* --- Chat Area --- */

#chat-area {
    height: 1fr;
    min-height: 3;
    padding: 0 1;
}

.message {
    padding: 0 2;
    margin: 0;
    width: 100%;
    height: auto;
}

.user-row {
    height: auto;
    width: 100%;
    margin: 1 0;
}

.user-message {
    color: $text;
    padding: 0 2;
}

.ai-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.ai-message {
    color: $text;
}

.error-message {
    color: $error;
    padding: 0 2;
}

.system-message {
    color: $text-muted;
    padding: 0 2;
}

/* --- Tool Call Block --- */

.tool-block {
    padding: 0 2;
    width: 100%;
    height: auto;
    color: $text-muted;
}

.tool-block-loading {
    color: $text-muted;
}

.tool-block-error {
    color: $error;
}

/* --- Thinking Display --- */

.thinking-done {
    color: $text-muted;
}

/* --- Sub-Agent Block --- */

.subagent-block {
    color: $text;
    padding: 0 2;
}

/* --- Input Area --- */

#spinner-live {
    height: 1;
    padding: 0 2;
}

#input-area {
    dock: bottom;
    height: auto;
    max-height: 20;
    padding: 0 1;
    border-top: solid #353c47;
}

#chat-input {
    height: auto;
    min-height: 1;
    max-height: 10;
    border: none;
    padding: 0 1 1 1;
    background: $background;
}

StatusBar {
    height: 2;
    width: 100%;
    padding: 0 1;
}

#mode-label {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#model-label {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatusDetailsScreen {
    align: center middle;
    background: $background 70%;
}

#status-dialog {
    width: 90%;
    max-width: 90;
    height: 90%;
    max-height: 32;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#status-title {
    height: 1;
    text-style: bold;
    margin-bottom: 1;
}

#status-detail-scroll {
    height: 1fr;
}

#status-details {
    height: auto;
}

#status-close {
    margin-top: 1;
    min-width: 14;
    height: 3;
}

/* --- Teammate Tree --- */

#teammate-tree {
    height: auto;
    padding: 0 2;
}

/* --- Plan Approval Dialog --- */

PlanApprovalDialog {
    align: center middle;
}

#plan-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: solid $warning;
}

#plan-title {
    text-style: bold;
    text-align: center;
    padding: 0 0 1 0;
}

#plan-dialog Button {
    width: 100%;
    margin: 0 0 1 0;
}

/* --- AskUser Dialog --- */

AskUserDialog {
    align: center middle;
}

#askuser-dialog {
    width: 64;
    height: auto;
    max-height: 20;
    padding: 1 2;
    background: $surface;
    border: solid $accent;
}

#askuser-title {
    text-style: bold;
    text-align: center;
    padding: 0 0 1 0;
}

#askuser-options {
    height: auto;
    max-height: 12;
}

/* --- Inline Permission Widget --- */

#perm-inline {
    height: auto;
    padding: 0 0;
    margin: 0 0;
}

#perm-content {
    padding: 0 0;
}

/* --- Inline Plan Widget --- */

#plan-inline {
    height: auto;
    padding: 0 0;
}

#plan-content {
    padding: 0 0;
}

/* --- Inline AskUser Widget --- */

#askuser-inline {
    height: auto;
    padding: 0 0;
}

#askuser-content {
    padding: 0 0;
}

/* --- Inline Resume Widget --- */

#resume-inline {
    height: auto;
    padding: 0 0;
}

#resume-content {
    padding: 0 0;
}
