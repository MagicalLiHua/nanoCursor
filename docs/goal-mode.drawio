<mxfile host="app.diagrams.net" type="device">
  <diagram id="goal-mode" name="NanoCursor Goal 模式提案">
    <mxGraphModel dx="1420" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="980" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="NanoCursor · Goal 模式设计提案" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1290" height="45" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="目标控制在现有 Agent.run() 外层；权限、恢复与人工边界不变 · 2026-09-30" style="text;html=1;align=left;fontSize=16;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="1290" height="35" as="geometry" /></mxCell>
        <mxCell id="entry" value="用户入口&lt;br&gt;&lt;b&gt;TUI / headless / remote&lt;/b&gt;&lt;br&gt;设置 · 暂停 · 恢复 · 补充信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=18;fontColor=#172554;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="165" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="runner" value="&lt;b&gt;GoalRunner / Controller&lt;/b&gt;&lt;br&gt;单一前台所有者 · revision 检查&lt;br&gt;判断继续、等待与目标终态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=18;fontColor=#172554;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="325" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="store" value="&lt;b&gt;GoalStore + UsageLedger&lt;/b&gt;&lt;br&gt;复用 RecoveryStore / SQLite&lt;br&gt;目标、预算、幂等结算、版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=17;fontColor=#14532d;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="325" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="gates" value="&lt;b&gt;续跑准入&lt;/b&gt;&lt;br&gt;用户输入与审批优先&lt;br&gt;预算 · 无进展 · 恢复安全" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=17;fontColor=#7c2d12;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="325" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="agent" value="&lt;b&gt;现有 Agent.run()&lt;/b&gt;&lt;br&gt;模型 → 工具 → 结果 → 模型&lt;br&gt;保留压缩、权限和恢复保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=18;fontColor=#4c1d95;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="boundary" value="&lt;b&gt;回合结束 / 明确退出原因&lt;/b&gt;&lt;br&gt;final · Plan 边界 · 错误 · 中断&lt;br&gt;先完成工具收尾，再判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=17;fontColor=#4c1d95;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="530" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="acceptance" value="&lt;b&gt;AcceptanceGate&lt;/b&gt;&lt;br&gt;要求覆盖 · 实际证据 · 可选硬检查&lt;br&gt;模型说“完成”不单独算验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=17;fontColor=#7c2d12;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="530" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="next" value="&lt;b&gt;接纳一次内部续跑&lt;/b&gt;&lt;br&gt;目标 + 定向反馈 + 剩余限额&lt;br&gt;不是新的用户授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=17;fontColor=#172554;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="765" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="stop" value="&lt;b&gt;等待 / 非完成停止&lt;/b&gt;&lt;br&gt;paused · blocked · suspended&lt;br&gt;budget_limited · 保留目标与证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=17;fontColor=#7f1d1d;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="765" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="complete" value="&lt;b&gt;目标完成 · complete&lt;/b&gt;&lt;br&gt;全部约定条件通过审计&lt;br&gt;停止调度，输出证据与用量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=17;fontColor=#14532d;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="765" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="footnote" value="核心不变量：回合结束 ≠ 目标完成；自动续跑 ≠ 额外权限；恢复未知结果 ≠ 自动重试。所有模块均为设计提案。" style="text;html=1;align=left;fontSize=15;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="1300" height="35" as="geometry" /></mxCell>
        <mxCell id="entry-runner" value="明确用户操作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#2563eb;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="runner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="runner-store" value="读写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#16a34a;startArrow=classic;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="runner" target="store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="store-gates" value="状态与限额" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#ea580c;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="store" target="gates"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="runner-agent" value="准入后运行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="runner" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="agent-boundary" value="完成当前回合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent" target="boundary"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="boundary-acceptance" value="正常 final" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#ea580c;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="boundary" target="acceptance"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gates-acceptance" value="策略与条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#ea580c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gates" target="acceptance"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="boundary-stop" value="错误 / 人工边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="boundary" target="stop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="acceptance-complete" value="审计通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#16a34a;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="acceptance" target="complete"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="acceptance-next" value="尚未完成且准入通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#2563eb;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="acceptance" target="next"><mxGeometry x="0.2" y="-12" relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="590" /><mxPoint x="1330" y="895" /><mxPoint x="245" y="895" /></Array></mxGeometry></mxCell>
        <mxCell id="next-runner" value="空闲时接纳；重新校验版本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#2563eb;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="next" target="runner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="815" /><mxPoint x="35" y="385" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
