providers:
  - name: deepseek
    protocol: openai-compat
    base_url: https://api.deepseek.com
    model: deepseek-chat
    thinking: false

permission_mode: default
mcp_servers: []
hooks: []
enable_fork: false
enable_verification_agent: false
enable_coordinator_mode: false

sandbox:
  enabled: true
  auto_allow: false
  network_enabled: false
