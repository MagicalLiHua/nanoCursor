# nanoCursor 配置文件
# 复制此文件为 .env 并根据需要修改配置

# ==========================================
# LLM 模型配置
# ==========================================

# 模型提供商选择 (anthropic, deepseek, minimax, openai, ollama)
# 可以显式指定 LLM_PROVIDER，或让系统自动检测（哪个 *_API_KEY 已设置就用哪个）
# 自动检测优先级: anthropic > deepseek > minimax > openai > ollama
# LLM_PROVIDER=deepseek

# 通用 LLM 参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
# 如果使用兼容 API（如 Azure、本地代理等）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Ollama (本地模型) ---
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# --- DeepSeek ---
# DEEPSEEK_API_KEY=<YOUR_API_KEY_HERE>
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- MiniMax ---
# MINIMAX_API_KEY=<YOUR_API_KEY_HERE>
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ==========================================
# 工作区配置
# ==========================================

# 默认用户工作区。留空时使用 .nanocursor/workspaces/default。
# 这个目录用于未显式打开项目时的隔离运行，避免污染 nanoCursor 源码目录。
# NANOCURSOR_WORKSPACE_DIR=/absolute/path/to/your/project

# 默认工作区集合根目录。留空时使用 .nanocursor/workspaces。
# NANOCURSOR_WORKSPACE_ROOT=/absolute/path/to/nanocursor-workspaces

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
# 可选：将日志输出到文件
# LOG_FILE=logs/nanocursor.log

# ==========================================
# 上下文管理配置
# ==========================================
CONTEXT_MAX_TOKENS=8000
CODER_KEEP_TURNS=4
PLANNER_KEEP_TURNS=3
REVIEWER_KEEP_TURNS=2

# ==========================================
# Docker 沙盒配置 (可选)
# ==========================================
# 注意：key 名称必须与 config.py 中一致
SANDBOX_MEM_LIMIT=256m
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_CPU_QUOTA_PERCENT=50

# ==========================================
# Agent 行为配置
# ==========================================
MAX_CODER_STEPS=15
MAX_PLANNER_STEPS=10
LLM_TIMEOUT_SECONDS=30
MAX_CONCURRENT_RUNS=5

# ==========================================
# Go 微服务（可选增强）
# ==========================================
# indexer/filetools 默认启用 feature flag，但仍保留 Python fallback。
# 如果对应 Go sidecar 未启动，系统会自动回退，不会阻塞普通开发启动。
# executor 仍然默认关闭：它的价值是隔离、取消、事件治理，不适合宣传为短命令加速。

# Go gRPC 项目索引服务：go-services/indexer，默认端口 50051
NANOCURSOR_GO_INDEXER_ENABLED=true
NANOCURSOR_GO_INDEXER_FALLBACK=true
NANOCURSOR_GO_INDEXER_ADDR=localhost:50051
NANOCURSOR_GO_INDEXER_FAILURE_COOLDOWN_SECONDS=10

# Go gRPC 命令执行服务：go-services/executor，默认端口 50055
# NANOCURSOR_GO_EXECUTOR_ENABLED=false
# NANOCURSOR_GO_EXECUTOR_FALLBACK=true
# NANOCURSOR_GO_EXECUTOR_ADDR=localhost:50055
# NANOCURSOR_EXECUTOR_POLL_INTERVAL_MS=20

# Go gRPC 文件工具服务：go-services/filetools，默认端口 50054
# 默认启用；如果服务未启动，会自动 fallback 到 Python 文件工具。
NANOCURSOR_GO_FILETOOLS_ENABLED=true
NANOCURSOR_GO_FILETOOLS_FALLBACK=true
NANOCURSOR_GO_FILETOOLS_ADDR=localhost:50054
# Go filetools 连接失败后的临时冷却时间，避免重复连接失败刷屏。
NANOCURSOR_GO_FILETOOLS_FAILURE_COOLDOWN_SECONDS=10
